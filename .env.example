# ==============================================================================
# CareerPilot AI — Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CareerPilot AI"
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5678,http://127.0.0.1:5678

# PostgreSQL Database & pgvector Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot_dev_password
POSTGRES_DB=careerpilot_db
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot_dev_password@localhost:5432/careerpilot_db

# LLM Provider API Keys (Set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default LLM Configuration
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# Storage Configuration (Local File System or S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="CareerPilot AI"

# Optional: Email Service (SMTP for HITL user-approved dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME="CareerPilot Copilot"

# n8n Workflow Automation (Phase 16 - Self-Hosted Community Edition)
N8N_ENABLED=true
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=your-secure-n8n-webhook-secret-min-32-chars

# Multi-Source Job Discovery Settings (Phase 16B)
JOB_SOURCE_LINKEDIN_ENABLED=true
JOB_SOURCE_FRESHERSHUNT_ENABLED=true
JOB_SOURCE_COMPANY_CAREERS_ENABLED=true
JOB_SOURCE_INDEED_ENABLED=true
JOB_SOURCE_PUBLIC_FEEDS_ENABLED=true
JOB_DISCOVERY_DEFAULT_MIN_SCORE=65.0

