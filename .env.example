# ==============================================================================
# CareerPilot AI — Environment Configuration Template
# Copy this file to .env for local development, or configure these variables
# directly in Render (Backend) and Vercel (Frontend).
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (BACKEND) PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="CareerPilot AI"
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Backend API & Authentication
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
# Generate a strong 32+ character hex key: `openssl rand -hex 32`
SECRET_KEY=generate-a-strong-secret-key-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production Allowed Origins (Comma-separated)
# Must include your live Vercel frontend URL and any custom domains
BACKEND_CORS_ORIGINS=https://career-pilot-kappa-flax.vercel.app,https://careerpilot.vercel.app,http://localhost:3000

# PostgreSQL Database & pgvector Configuration (e.g. Supabase / Neon / Render PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres.example:password@aws-0-region.pooler.supabase.com:5432/postgres?ssl=require

# Storage Configuration (local or supabase/s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage

# ------------------------------------------------------------------------------
# 2. VERCEL (FRONTEND) PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables:
# NEXT_PUBLIC_API_URL: Set to `/api/v1` (to use Next.js rewrites) or your full Render URL
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME="CareerPilot AI"
# BACKEND_URL: Used by Next.js server-side rewrites in next.config.js
BACKEND_URL=https://careerpilot-backend-fk3o.onrender.com

# ------------------------------------------------------------------------------
# 3. OPTIONAL AI PROVIDER CONFIGURATION (For LLM Resume Tailoring & Mock Interview)
# If no key is set, CareerPilot continues to operate with deterministic AST tailoring.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 4. OPTIONAL SERVICES (n8n Workflow Automation & Email)
# ------------------------------------------------------------------------------
N8N_ENABLED=false
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=careerpilot-n8n-dev-webhook-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME="CareerPilot Copilot"

# ------------------------------------------------------------------------------
# 5. MULTI-SOURCE JOB DISCOVERY SETTINGS
# ------------------------------------------------------------------------------
JOB_SOURCE_LINKEDIN_ENABLED=true
JOB_SOURCE_FRESHERSHUNT_ENABLED=true
JOB_SOURCE_COMPANY_CAREERS_ENABLED=true
JOB_SOURCE_INDEED_ENABLED=true
JOB_SOURCE_PUBLIC_FEEDS_ENABLED=true
JOB_DISCOVERY_DEFAULT_MIN_SCORE=65.0
