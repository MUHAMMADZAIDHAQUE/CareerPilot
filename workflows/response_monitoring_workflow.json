      "position": [440, 380]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "f8c40001-1111-4000-8000-000000000005",
      "name": "Inbound Ingestion Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 380]
    }
