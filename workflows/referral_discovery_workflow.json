{
  "id": "CPReferralDiscovery001",
  "name": "CareerPilot Referral Discovery Engine",
  "nodes": [
    {
      "parameters": {},
      "id": "f8c30001-1111-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [160, 240]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "f8c30001-1111-4000-8000-000000000002",
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [160, 380]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "careerpilot-referral-discovery",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f8c30001-1111-4000-8000-000000000003",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [160, 520],
      "webhookId": "4d9f02b1-5c6d-49ea-b83f-2d0a5e3f9c8b"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/v1/referrals/discover",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $json.body?.job_id || 'sample-job-id' }}\",\n  \"target_count\": 50,\n  \"min_score\": 0.0\n}",
        "options": {}
      },
      "id": "f8c30001-1111-4000-8000-000000000004",
      "name": "Trigger Referral Discovery API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [440, 380]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const res = $json;\nreturn {\n  job_id: res.job_id,\n  company: res.company,\n  role: res.role,\n  target_count: res.target_count || 50,\n  total_discovered: res.total_discovered || 0,\n  total_verified: res.total_verified || 0,\n  target_reached: res.target_reached || false,\n  shortfall: res.shortfall || 0,\n  contacts_count: (res.contacts || []).length,\n  alert_message: res.target_reached \n    ? `Found ${res.total_verified} verified referral opportunities for ${res.company}.`\n    : `Target not reached: ${res.total_verified}/50 verified contacts found for ${res.company} (shortfall: ${res.shortfall}).`\n};"
      },
      "id": "f8c30001-1111-4000-8000-000000000005",
      "name": "Format Referral Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 380]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "f8c30001-1111-4000-8000-000000000006",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [940, 520]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Trigger Referral Discovery API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Trigger Referral Discovery API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Trigger Referral Discovery API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Referral Discovery API": {
      "main": [
        [
          {
            "node": "Format Referral Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Referral Report": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
